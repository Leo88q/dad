# Docker Compose reads .env. npm start does NOT; use server environment or
# node --env-file=.env server.js. Keep this file private: chmod 600 .env.
NODE_ENV=production
APP_DOMAIN=ryadom.example.invalid
MAX_BOT_NAME=
# Server secret. Never put the real token in chat, source control or frontend.
MAX_BOT_TOKEN=
MAX_ONLY=true
# For a non-Compose Node deployment set the canonical public HTTPS origin:
PUBLIC_URL=https://ryadom.example.invalid

# Required in production. Set real published documents, not placeholder links.
OPERATOR_NAME=
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=
# Change when the operator updates processing terms; triggers renewed consent.
DATA_POLICY_VERSION=
# Absolute persistent path for direct Node deployment (Compose sets /app/data).
DATA_DIR=/srv/ryadom/data

# Mandatory for Compose backup-worker. Generate with scripts/backup-key.js.
# Absolute HOST file path; readable by container UID 1000, mode 0600/0400.
# Keep an independent offline copy; do not put key contents here.
BACKUP_KEY_HOST_FILE=/srv/ryadom/secrets/backup-key
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=56
# Direct Node deployment instead uses BACKUP_KEY_FILE and BACKUP_DIR.
